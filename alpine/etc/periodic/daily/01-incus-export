#!/bin/sh
set -e

CURL="curl -fsS -m 10 --retry 5 -o /dev/null"
EXPORT_URL=""
KOPIA_URL=""
REMOTE=hbd

kopia snapshot create --all --no-progress
$CURL $KOPIA_URL

if [ "$(df -P / | awk 'NR==2 {gsub(/%/, "", $5); print $5}')" -gt 70 ]; then
  echo "Not enough free space"
  exit 1
fi

INSTANCES=$(incus list -c n -f csv)
for i in $INSTANCES; do
  OUT="incus-exports/$i.$(date +%u).tar.gpg"
  incus export $i --compression none --instance-only --optimized-storage - |
    gpg --batch --yes --symmetric --passphrase-file ~/.gnupg/password.txt - |
    ssh $REMOTE "cat > $OUT"
done

fstrim -av
$CURL $EXPORT_URL
